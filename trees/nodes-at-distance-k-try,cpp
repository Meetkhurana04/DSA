struct node
{
  int data;
  node *left;
  node *right;
  node *parent ; 

  node(int val)
  {
    data = val;
    left = NULL;
    right = NULL;
    parent = NULL;
  }
};

void setupparent(node* root){
  if(root==NULL){
    return ; 
  }
  queue<node *>q ; 
  q.push(root);
  while(!q.empty()){
    node* cur = q.front() ; 
    q.pop() ; 
    if(cur->left){
       cur->left->parent=cur ;
       q.push(cur->left);
       
    }
    if(cur->right) {
      cur->right->parent = cur;
      q.push(cur->right);
    }
  }
}

